# ─────────────────────────────────────────────────────────
# CONFIGURATION E-PLANNER CMR
# ─────────────────────────────────────────────────────────
# Copier ce fichier en .env et remplir les valeurs réelles
# Ne JAMAIS commiter le fichier .env avec les vrais secrets
# ─────────────────────────────────────────────────────────

# Environnement d'exécution
NODE_ENV=development

# Port d'écoute du serveur
PORT=3000

# Origins CORS autorisées (virgule-séparées)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ─────────────────────────────────────────────────────────
# Intégration WhatsApp Business API
# ─────────────────────────────────────────────────────────

# URL de base de l'API WhatsApp
WHATSAPP_API_URL=https://api.whatsapp.example.com/v1

# Token d'authentification WhatsApp (Bearer token)
WHATSAPP_API_TOKEN=your-whatsapp-bearer-token-here

# Numéro de téléphone d'envoi (format E.164, ex: +237123456789)
WHATSAPP_SENDER_PHONE=+237XXXXXXXXX

# ─────────────────────────────────────────────────────────
# Base de Données (pour développements futurs)
# ─────────────────────────────────────────────────────────

# DATABASE_URL=postgresql://user:password@localhost:5432/eplanner_db
# DATABASE_POOL_SIZE=10
# DATABASE_SSL_MODE=disable

# ─────────────────────────────────────────────────────────
# Logging & Monitoring
# ─────────────────────────────────────────────────────────

# Niveau de log (debug, info, warn, error)
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────
# Clés secrètes (JWT, sessions, etc.)
# ─────────────────────────────────────────────────────────

# JWT_SECRET=your-super-secret-jwt-key-change-in-production
# SESSION_SECRET=your-session-secret-key

# ─────────────────────────────────────────────────────────
# Localisation Cameroun
# ─────────────────────────────────────────────────────────

# Devise par défaut (XAF = Franc CFA)
DEFAULT_CURRENCY=XAF

# Fuseau horaire
TIMEZONE=Africa/Douala
